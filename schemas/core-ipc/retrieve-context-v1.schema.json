{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgermind.dev/schemas/core-ipc/retrieve-context-v1.schema.json",
  "title": "LedgerMind Core IPC v1 retrieve context payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["memory_space_id", "query", "limit"],
  "properties": {
    "memory_space_id": {"type": "string", "minLength": 1},
    "query": {"type": "string", "minLength": 1},
    "limit": {"type": "integer", "minimum": 1, "maximum": 100}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgermind.dev/schemas/core-ipc/prepare-restore-v1.schema.json",
  "title": "LedgerMind Core IPC v1 prepare restore payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["relative_path", "sha256"],
  "properties": {
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^exchange/incoming/(?!$)(?:(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000]+(?:/|$))+$"
    },
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}

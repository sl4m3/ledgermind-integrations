{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgermind.dev/schemas/core-ipc/accept-hypothesis-v1.schema.json",
  "title": "LedgerMind Core IPC v1 accept hypothesis payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "command_id", "idempotency_key", "memory_space_id", "hypothesis"],
  "properties": {
    "protocol_version": {"const": 1},
    "command_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "memory_space_id": {"type": "string", "minLength": 1},
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesis_id", "content_digest", "title", "target", "statement", "evidence", "extraction"],
      "properties": {
        "hypothesis_id": {"type": "string", "minLength": 1},
        "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "title": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "rationale": {"type": "string"},
        "result": {"type": "string"},
        "artifacts": {"type": "array", "items": {"type": "string"}},
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_system", "source_instance_id", "source_profile_id", "source_session_id", "source_round_id", "raw_round_digest", "normalized_round_digest", "source_event_ids"],
          "properties": {
            "source_system": {"type": "string", "minLength": 1},
            "source_instance_id": {"type": "string", "minLength": 1},
            "source_profile_id": {"type": "string", "minLength": 1},
            "source_session_id": {"type": "string", "minLength": 1},
            "source_round_id": {"type": "string", "minLength": 1},
            "raw_round_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "normalized_round_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "source_event_ids": {"type": "array", "items": {"type": "string"}}
          }
        },
        "extraction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "model", "prompt_version", "schema_version", "completed_at"],
          "properties": {
            "provider": {"type": "string", "minLength": 1},
            "model": {"type": "string", "minLength": 1},
            "prompt_version": {"type": "integer", "minimum": 1},
            "schema_version": {"type": "integer", "minimum": 1},
            "completed_at": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}

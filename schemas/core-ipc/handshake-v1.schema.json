{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgermind.dev/schemas/core-ipc/handshake-v1.schema.json",
  "title": "LedgerMind Core IPC v1 handshake payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["client_name", "client_version", "supported_operations"],
  "properties": {
    "client_name": {"type": "string", "minLength": 1},
    "client_version": {"type": "string", "minLength": 1},
    "supported_operations": {
      "type": "array",
      "items": {"$ref": "#/$defs/operation"},
      "minItems": 1,
      "uniqueItems": true
    },
    "capabilities": {"type": "object", "additionalProperties": {}}
  },
  "$defs": {
    "operation": {
      "type": "string",
      "enum": ["handshake", "health", "accept_hypothesis", "retrieve_context", "record_context_usage", "poll_projection_events", "ack_projection_events", "poll_model_tasks", "submit_model_result", "fail_model_task", "create_backup", "validate_backup", "prepare_restore", "begin_restore", "commit_restore", "rollback_restore", "shutdown"]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgermind.dev/schemas/core-ipc/handshake-v1.schema.json",
  "title": "LedgerMind Core IPC v1 handshake payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["client_name", "client_version", "supported_operations"],
  "properties": {
    "client_name": {"type": "string", "minLength": 1},
    "client_version": {"type": "string", "minLength": 1},
    "supported_operations": {
      "type": "array",
      "items": {"$ref": "#/$defs/operation"},
      "minItems": 1,
      "uniqueItems": true
    },
    "capabilities": {"type": "object", "additionalProperties": {}}
  },
  "$defs": {
    "operation": {
      "type": "string",
      "enum": ["handshake", "health", "poll_projection_events", "ack_projection_events", "create_backup", "validate_backup", "prepare_restore", "begin_restore", "commit_restore", "rollback_restore", "ingest_raw_round_v2", "poll_execution_tasks_v2", "submit_execution_result_v2", "fail_execution_task_v2", "retrieve_context_v2", "record_retrieval_outcome_v2", "run_control_maintenance_v1", "get_object_facet_statistics_v1", "shutdown"]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgermind.dev/schemas/core-ipc/object-facet-v1/operational-extraction-input-v1.schema.json",
  "title": "LedgerMind object-facet v1 operational extraction input",
  "type": "object",
  "additionalProperties": false,
  "required": ["mentions"],
  "properties": {
    "mentions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {"$ref": "#/$defs/mention"}
    }
  },
  "$defs": {
    "mention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mention_ref", "surface_text", "normalized_text", "candidates"],
      "properties": {
        "mention_ref": {"type": "string", "minLength": 1, "maxLength": 500},
        "surface_text": {"type": "string", "minLength": 1, "maxLength": 20000},
        "normalized_text": {"type": "string", "minLength": 1, "maxLength": 20000},
        "candidates": {
          "type": "array",
          "maxItems": 8,
          "items": {"$ref": "#/$defs/candidate"}
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "canonical_name",
        "lexical_score",
        "embedding_score",
        "context_score"
      ],
      "properties": {
        "object_id": {"type": "string", "minLength": 1, "maxLength": 500},
        "canonical_name": {"type": "string", "minLength": 1, "maxLength": 500},
        "aliases": {
          "type": "array",
          "maxItems": 32,
          "items": {"type": "string", "minLength": 1, "maxLength": 500},
          "uniqueItems": true
        },
        "match_reasons": {
          "type": "array",
          "maxItems": 16,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "lexical_score": {"type": "number", "minimum": 0, "maximum": 1},
        "embedding_score": {"type": "number", "minimum": 0, "maximum": 1},
        "context_score": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}

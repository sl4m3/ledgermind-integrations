{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgermind.dev/schemas/core-ipc/object-facet-v1/operational-extraction-result-v1.schema.json",
  "title": "LedgerMind object-facet v1 operational extraction result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "objects": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/resolved_object"
      }
    },
    "values": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/extracted_value"
      }
    }
  },
  "$defs": {
    "facet": {
      "enum": [
        "identity",
        "property",
        "state",
        "function",
        "structure",
        "procedure",
        "maintenance",
        "risk",
        "constraint",
        "preference",
        "decision",
        "experience",
        "relation",
        "event"
      ]
    },
    "resolved_object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "mention_ref",
        "resolution",
        "source_event_ids"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "mention_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "resolution": {
          "enum": [
            "existing",
            "new",
            "ambiguous"
          ]
        },
        "existing_object_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "new_canonical_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "ambiguous_candidate_ids": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "uniqueItems": true
        },
        "aliases_from_source": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "uniqueItems": true
        },
        "source_event_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "uniqueItems": true
        }
      },
      "oneOf": [
        {
          "properties": {
            "resolution": {
              "const": "existing"
            }
          },
          "required": [
            "resolution",
            "existing_object_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "new_canonical_name"
                ]
              },
              {
                "required": [
                  "ambiguous_candidate_ids"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "resolution": {
              "const": "new"
            }
          },
          "required": [
            "resolution",
            "new_canonical_name"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "existing_object_id"
                ]
              },
              {
                "required": [
                  "ambiguous_candidate_ids"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "resolution": {
              "const": "ambiguous"
            }
          },
          "required": [
            "resolution",
            "new_canonical_name",
            "ambiguous_candidate_ids"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "existing_object_id"
                ]
              }
            ]
          }
        }
      ]
    },
    "extracted_value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_object_ref",
        "facet",
        "content",
        "source_kind",
        "source_event_ids"
      ],
      "properties": {
        "primary_object_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "related_object_refs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "uniqueItems": true
        },
        "facet": {
          "$ref": "#/$defs/facet"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "source_kind": {
          "enum": [
            "explicit_user",
            "assistant_output",
            "tool_observation",
            "external_source",
            "derived_experience",
            "memory_echo"
          ]
        },
        "source_event_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "uniqueItems": true
        },
        "scope_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_to": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "required": [
    "objects",
    "values"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgermind.dev/schemas/core-ipc/object-facet-v1/embed-result-v1.schema.json",
  "title": "LedgerMind object-facet v1 embed result",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "model_id", "model_version", "dimensions", "vectors"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1, "maxLength": 500},
    "model_id": {"type": "string", "minLength": 1, "maxLength": 500},
    "model_version": {"type": "string", "minLength": 1, "maxLength": 500},
    "dimensions": {"type": "integer", "minimum": 1, "maximum": 8192},
    "vectors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8192,
        "items": {"type": "number"}
      }
    }
  }
}

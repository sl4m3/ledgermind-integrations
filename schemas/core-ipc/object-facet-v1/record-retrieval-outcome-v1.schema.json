{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgermind.dev/schemas/core-ipc/object-facet-v1/record-retrieval-outcome-v1.schema.json",
  "title": "LedgerMind object-facet v1 record retrieval outcome",
  "type": "object",
  "additionalProperties": false,
  "required": ["retrieval_request_id", "candidate_value_ids", "delivered_value_ids", "created_at"],
  "properties": {
    "retrieval_request_id": {"type": "string", "minLength": 1, "maxLength": 500},
    "candidate_value_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {"type": "string", "minLength": 1, "maxLength": 500},
      "uniqueItems": true
    },
    "delivered_value_ids": {
      "type": "array",
      "maxItems": 500,
      "items": {"type": "string", "minLength": 1, "maxLength": 500},
      "uniqueItems": true
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgermind.dev/schemas/core-ipc/object-facet-v1/resolution-context-v1.schema.json",
  "title": "LedgerMind object-facet v1 resolution context",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "project_id": {"type": "string", "minLength": 1, "maxLength": 500},
    "repository_id": {"type": "string", "minLength": 1, "maxLength": 500},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 500},
    "conversation_id": {"type": "string", "minLength": 1, "maxLength": 500},
    "related_object_ids": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 500},
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {"required": ["repository_id"]},
      "then": {"required": ["project_id"]}
    }
  ]
}

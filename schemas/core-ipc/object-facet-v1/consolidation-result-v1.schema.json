{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgermind.dev/schemas/core-ipc/object-facet-v1/consolidation-result-v1.schema.json",
  "title": "LedgerMind object-facet v1 consolidation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "source_value_ids", "result"],
  "properties": {
    "action": {"enum": ["merge", "replace"]},
    "source_value_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 500},
      "uniqueItems": true
    },
    "result": {"$ref": "#/$defs/consolidated_value"}
  },
  "$defs": {
    "consolidated_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_object_id", "facet", "content"],
      "properties": {
        "primary_object_id": {"type": "string", "minLength": 1, "maxLength": 500},
        "related_object_ids": {
          "type": "array",
          "maxItems": 32,
          "items": {"type": "string", "minLength": 1, "maxLength": 500},
          "uniqueItems": true
        },
        "facet": {
          "enum": [
            "identity",
            "property",
            "state",
            "function",
            "structure",
            "procedure",
            "maintenance",
            "risk",
            "constraint",
            "preference",
            "decision",
            "experience",
            "relation",
            "event"
          ]
        },
        "content": {"type": "string", "minLength": 1, "maxLength": 20000},
        "scope_text": {"type": "string", "minLength": 1, "maxLength": 20000},
        "valid_from": {"type": "string", "format": "date-time"},
        "valid_to": {"type": "string", "format": "date-time"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgermind.dev/schemas/core-ipc/object-facet-v1/retrieval-request-v1.schema.json",
  "title": "LedgerMind object-facet v1 retrieval request",
  "type": "object",
  "additionalProperties": false,
  "required": ["memory_space_id", "query_text", "query_embedding", "embedding_model_id", "embedding_model_version", "limit", "explanation_level"],
  "properties": {
    "memory_space_id": {"type": "string", "minLength": 1, "maxLength": 500},
    "query_text": {"type": "string", "minLength": 1, "maxLength": 20000},
    "query_embedding": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8192,
      "items": {"type": "number"}
    },
    "embedding_model_id": {"type": "string", "minLength": 1, "maxLength": 500},
    "embedding_model_version": {"type": "string", "minLength": 1, "maxLength": 500},
    "limit": {"type": "integer", "minimum": 1, "maximum": 100},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 500},
    "repository_id": {"type": "string", "minLength": 1, "maxLength": 500},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 500},
    "conversation_id": {"type": "string", "minLength": 1, "maxLength": 500},
    "related_object_ids": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 500},
      "uniqueItems": true
    },
    "requested_facets": {
      "type": "array",
      "maxItems": 14,
      "uniqueItems": true,
      "items": {
        "enum": [
          "identity",
          "property",
          "state",
          "function",
          "structure",
          "procedure",
          "maintenance",
          "risk",
          "constraint",
          "preference",
          "decision",
          "experience",
          "relation",
          "event"
        ]
      }
    },
    "explanation_level": {"enum": ["compact", "none"]}
  },
  "allOf": [
    {
      "if": {"required": ["repository_id"]},
      "then": {"required": ["project_id"]}
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgermind.dev/schemas/core-ipc/object-facet-v2/context-view-v2.schema.json",
  "title": "LedgerMind ContextView v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "retrieval_request_id", "items", "delivered_value_ids"],
  "properties": {
    "api_version": {"const": "2"},
    "retrieval_request_id": {"type": "string", "minLength": 1, "maxLength": 500},
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "retrieval-response-v2.schema.json#/$defs/retrieval_item"}
    },
    "delivered_value_ids": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgermind.dev/schemas/core-ipc/object-facet-v2/generic-execution-task-v2.schema.json",
  "title": "LedgerMind object-facet v2 generic execution task",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "task_kind", "operation", "profile_slot", "memory_space_id", "expires_at"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1, "maxLength": 500},
    "task_kind": {"enum": ["generate_json", "embed_texts"]},
    "operation": {"type": "string", "minLength": 1, "maxLength": 500},
    "profile_slot": {"enum": ["operational", "background", "embedding"]},
    "memory_space_id": {"type": "string", "minLength": 1, "maxLength": 500},
    "expires_at": {"type": "string", "format": "date-time"},
    "lease": {"type": "string", "format": "date-time"},
    "model_request": {"$ref": "#/$defs/model_request"},
    "embedding_request": {"$ref": "#/$defs/embedding_request"},
    "operation_input": {"type": "object"}
  },
  "oneOf": [
    {
      "properties": {"task_kind": {"const": "generate_json"}},
      "required": ["task_kind", "model_request"],
      "not": {"required": ["embedding_request"]}
    },
    {
      "properties": {"task_kind": {"const": "embed_texts"}},
      "required": ["task_kind", "embedding_request"],
      "not": {"required": ["model_request"]}
    }
  ],
  "$defs": {
    "model_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messages", "max_output_tokens", "response_format"],
      "properties": {
        "messages": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "object"}},
        "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 262144},
        "response_format": {"enum": ["json_object", "text"]}
      }
    },
    "embedding_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["texts", "purpose"],
      "properties": {
        "texts": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
        "purpose": {"enum": ["object_query", "object_mention", "object_card", "value_record", "retrieval_query", "facet_catalog"]},
        "dimensions": {"type": "integer", "minimum": 1, "maximum": 8192}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgermind.dev/schemas/core-ipc/fail-model-task-v1.schema.json",
  "title": "LedgerMind Core IPC v1 fail model task payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["memory_space_id", "task_id", "worker_id", "error_code", "retryable", "retry_after_seconds", "failed_at"],
  "properties": {
    "memory_space_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "worker_id": {"type": "string", "minLength": 1},
    "error_code": {"type": "string", "minLength": 1},
    "retryable": {"type": "boolean"},
    "retry_after_seconds": {"type": "integer", "minimum": 0, "maximum": 86400},
    "failed_at": {"type": "string", "format": "date-time"}
  }
}
